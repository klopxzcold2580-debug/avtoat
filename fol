#include <bits/stdc++.h>
using namespace std;
struct Rule { string from, term, to; };



map<string, map<string, set<string>>> nfa;   
map<string, set<string>> eps;              
set<string> states, alphabet, finals;
string start;

set<string> closure(set<string> s) {
    queue<string> q;
    for (auto &x : s) q.push(x);
    while (!q.empty()) {
        string v = q.front(); q.pop();
        for (auto &u : eps[v])
            if (s.insert(u).second) q.push(u);
    }
    return s;
}

vector<Rule> readGrammar(const string& filename, string& startSym) {
    ifstream f(filename);
    if (!f) { cerr << "Не могу открыть " << filename << "\n"; exit(1); }

    vector<Rule> rules;
    string line;
    bool first = true;

    while (getline(f, line)) {
        // убираем пробелы и \r
        line.erase(remove_if(line.begin(), line.end(),
                  [](char c){ return isspace((unsigned char)c); }), line.end());
        if (line.empty() || line[0] == '#') continue;  

        size_t arrow = line.find("->");
        if (arrow == string::npos) { cerr << "Нет '->' в: " << line << "\n"; continue; }

        string lhs = line.substr(0, arrow);
        string rhs = line.substr(arrow + 2);

        if (first) { startSym = lhs; first = false; }

        stringstream ss(rhs);
        string alt;
        while (getline(ss, alt, '|')) {
            if (alt.empty()) continue;
            Rule r; r.from = lhs;

            if (alt == "eps" || alt == "ε" || alt == "e") {
                r.term = "eps"; r.to = "";
            } else {
                r.term = string(1, alt[0]);
                r.to   = (alt.size() > 1) ? alt.substr(1) : "";
            }
            rules.push_back(r);
        }
    }
    return rules;
}

int main() {

    vector<Rule> rules = readGrammar("grammar.txt", start);
    cout << "Начальный символ: " << start << "\n";
    cout << "Правил прочитано: " << rules.size() << "\n";

    bool ok = true;
    for (auto &r : rules)
        if (r.term != "eps" && r.term.size() != 1) ok = false;
    cout << (ok ? "Грамматика регулярна\n" : "НЕ регулярна\n");
    if (!ok) return 0;


    string N = "N";
    for (auto &r : rules) {
        states.insert(r.from);
        if (!r.to.empty()) states.insert(r.to);
        if (r.term != "eps") alphabet.insert(r.term);

        if (r.term == "eps")   eps[r.from].insert(N);              // A -> eps
        else if (r.to.empty()) nfa[r.from][r.term].insert(N);      // A -> a
        else                   nfa[r.from][r.term].insert(r.to);   // A -> aB
    }
    states.insert(N);
    finals.insert(N);

   
    cout << "\nНКА:\n\t";
    for (auto &a : alphabet) cout << a << "\t";
    cout << "eps\n";
    for (auto &s : states) {
        cout << s << "\t";
        for (auto &a : alphabet) {
            auto &v = nfa[s][a];
            if (v.empty()) cout << "-\t";
            else { cout << "{"; for (auto &x : v) cout << x; cout << "}\t"; }
        }
        if (eps[s].empty()) cout << "-";
        else { cout << "{"; for (auto &x : eps[s]) cout << x; cout << "}"; }
        cout << "\n";
    }

    vector<set<string>> S;                      
    map<set<string>, int> idx;                   
    vector<map<string,int>> T;                   
    queue<int> q;

    S.push_back(closure({start}));
    idx[S[0]] = 0; q.push(0);
    T.push_back({});

    while (!q.empty()) {
        int i = q.front(); q.pop();
        for (auto &a : alphabet) {
            set<string> nx;
            for (auto &s : S[i])
                for (auto &t : nfa[s][a]) nx.insert(t);
            if (nx.empty()) continue;
            nx = closure(nx);
            if (!idx.count(nx)) {
                idx[nx] = S.size();
                S.push_back(nx);
                T.push_back({});
                q.push(S.size() - 1);
            }
            T[i][a] = idx[nx];
        }
    }


    cout << "\nДКА:\n\t";
    for (auto &a : alphabet) cout << a << "\t";
    cout << "\n";
    for (int i = 0; i < (int)S.size(); i++) {
        cout << "q" << i << "\t";
        for (auto &a : alphabet) {
            if (T[i].count(a)) cout << "q" << T[i][a] << "\t";
            else cout << "-\t";
        }
        cout << (S[i].count(N) ? "  (fin)" : "") << "\n";
    }
    cout << "Начальное: q0\nЗаключительные: ";
    for (int i = 0; i < (int)S.size(); i++)
        if (S[i].count(N)) cout << "q" << i << " ";
    cout << "\n";

   
    ofstream f("dfa.dot");
    f << "digraph DFA {\nrankdir=LR;\nnode[shape=doublecircle];\n";
    for (int i = 0; i < (int)S.size(); i++)
        if (S[i].count(N)) f << "q" << i << ";\n";
    f << "node[shape=circle];\nstart[shape=point];\nstart->q0;\n";
    for (int i = 0; i < (int)S.size(); i++)
        for (auto &p : T[i])
            f << "q" << i << "->q" << p.second
              << " [label=\"" << p.first << "\"];\n";
    f << "}\n";
}
